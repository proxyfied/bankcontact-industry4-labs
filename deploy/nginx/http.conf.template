server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;
    location = /nginx-health {
        allow 127.0.0.1;
        deny all;
        return 200 'ok';
    }
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        default_type text/plain;
        return 503 'HTTPS is not configured yet. Complete certificate setup.';
    }
}
