resolver 127.0.0.11 valid=10s ipv6=off;
upstream bankcontact {
    zone bankcontact 64k;
    server app:8080 resolve;
    keepalive 16;
}
server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;
    location = /nginx-health { return 200 'ok'; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://$host:${HTTPS_PORT}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://bankcontact;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port ${HTTPS_PORT};
        proxy_set_header Forwarded '';
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
