# Default /api uses the Vite proxy during development and Spring Boot in the JAR.
# For direct cross-origin access, set VITE_API_BASE_URL=http://localhost:8080/api
# and allow the frontend origin via backend CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api

VITE_ARTICLE_AI_URL=http://localhost:8082/articles

VITE_BI_API_URL=http://localhost:8083/api
