              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/agents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"OP-{{runToken}}\",\n  \"fullName\": \"Postman Agent\",\n  \"departmentId\": {{departmentId}},\n  \"skillIds\": {{skillIdsJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
