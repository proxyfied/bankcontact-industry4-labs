            "url": "{{baseUrl}}/api/tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketCode\": \"T-{{runToken}}\",\n  \"subject\": \"Postman Question\",\n  \"description\": \"Synthetic Postman test\",\n  \"status\": \"NEW\",\n  \"customerId\": {{customerId}},\n  \"assignedAgentId\": {{agentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
