{
  "info": {
    "name": "BankContact Lab 3 REST API",
    "description": "Start the server with the demo profile on a dedicated lab database. Run all folders in order. Data is synthetic. Collection format v2.1, compatible with Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "Read seed agent and initialize variables",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runToken\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); pm.response.json(); });",
                  "const first = pm.response.json().content[0];",
                  "pm.test(\"Demo data available\", () => pm.expect(first).to.be.an(\"object\"));",
                  "if (first) { pm.collectionVariables.set(\"departmentId\", first.departmentId); pm.collectionVariables.set(\"skillIdsJson\", JSON.stringify(first.skills.map(s => s.id))); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/agents?size=1"
          },
          "response": []
        }
      ]
    },
    {
      "name": "1 Create",
      "item": [
        {
          "name": "Create customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); pm.response.json(); });",
                  "const item=pm.response.json();",
                  "pm.collectionVariables.set(\"customerId\", item.id);",
                  "pm.test(\"Generated id and Location\", () => { pm.expect(item.id).to.be.a(\"number\"); pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/\"+item.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCode\": \"C-{{runToken}}\",\n  \"displayName\": \"Postman Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create agents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"JSON response\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); pm.response.json(); });",
                  "const item=pm.response.json();",
                  "pm.collectionVariables.set(\"agentId\", item.id);",
                  "pm.test(\"Generated id and Location\", () => { pm.expect(item.id).to.be.a(\"number\"); pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/\"+item.id); });"
                ]
